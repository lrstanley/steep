+/**
+ * Get the explicit OSC 8 id of the hyperlink at the grid reference's
+ * position. It writes no bytes for a cell with no hyperlink, or for a
+ * hyperlink without an id. Otherwise it works as
+ * ghostty_grid_ref_hyperlink_uri() does.
+ *
+ * @ingroup grid_ref
+ */
+GHOSTTY_API GhosttyResult ghostty_grid_ref_hyperlink_id(
+    const GhosttyGridRef *ref,
+    uint8_t *buf,
+    size_t buf_len,
+    size_t *out_len);
+
