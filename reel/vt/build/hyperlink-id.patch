diff --git a/src/terminal/c/grid_ref.zig b/src/terminal/c/grid_ref.zig
index 20f49be..aee4d6d 100644
--- a/src/terminal/c/grid_ref.zig
+++ b/src/terminal/c/grid_ref.zig
@@ -127,6 +127,31 @@ pub fn grid_ref_hyperlink_uri(
     return .success;
 }
 
+pub fn grid_ref_hyperlink_id(
+    ref: *const CGridRef,
+    out_buf: ?[*]u8,
+    buf_len: usize,
+    out_len: *usize,
+) callconv(lib.calling_conv) Result {
+    const p = ref.toPin() orelse return .invalid_value;
+    const terminal_page = p.node.page();
+    const cell = terminal_page.getRowAndCell(p.x, p.y).cell;
+
+    out_len.* = 0;
+    if (!cell.hyperlink) return .success;
+    const link_id = terminal_page.lookupHyperlink(cell) orelse return .success;
+    const entry = terminal_page.hyperlink_set.get(terminal_page.memory, link_id);
+    const id = switch (entry.id) {
+        .explicit => |slice| slice.slice(terminal_page.memory),
+        .implicit => return .success,
+    };
+
+    out_len.* = id.len;
+    if (out_buf == null or buf_len < id.len) return .out_of_space;
+    @memcpy(out_buf.?[0..id.len], id);
+    return .success;
+}
